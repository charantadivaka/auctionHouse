# Backend Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file — only this .env.example

NODE_ENV=development

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
DB_NAME=auction_house

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT Authentication ─────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=generate_a_strong_random_secret_min_32_chars
JWT_REFRESH_SECRET=generate_a_different_strong_random_secret_min_32_chars
JWT_EXPIRES_IN=7d

# ── App ────────────────────────────────────────────────────────────────────
APP_PORT=3001
FRONTEND_URL=http://localhost:3000

# ── SMTP Email ─────────────────────────────────────────────────────────────
# For Gmail: use an App Password (https://myaccount.google.com/apppasswords)
# For Mailtrap (dev): https://mailtrap.io
# For Resend (production): https://resend.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM=AuctionHouse <your_email@gmail.com>

# ── Google OAuth (optional) ────────────────────────────────────────────────
# GOOGLE_CLIENT_ID=your_google_client_id
# GOOGLE_CLIENT_SECRET=your_google_client_secret
# GOOGLE_CALLBACK_URL=http://localhost:3001/auth/google/callback
